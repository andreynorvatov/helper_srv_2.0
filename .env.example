# ===== Backend =====
# Порт, на котором слушает uvicorn внутри контейнера (не менять без нужды)
BACKEND_PORT=8000

# Внешние API: добавь по одному блоку на каждый источник.
# Имя источника (source) используется в запросе: GET /api/v1/fetch?source=NAME
# Пример:
# EXTERNAL_API_URL_WEATHER=https://api.open-meteo.com/v1/forecast
# EXTERNAL_API_KEY_WEATHER=your-secret-key-here

# OpenRouter: баланс через GET /api/v1/balance (эндпоинт /auth/key)
# EXTERNAL_API_URL_OPENROUTER=https://openrouter.ai/api/v1
# EXTERNAL_API_KEY_OPENROUTER=sk-or-...

# ===== Frontend =====
# Базовый URL API для продакшн-сборки (обычно пусто — nginx проксирует /api сам)
VITE_API_BASE=

# ===== Deploy =====
# Порт наружу на сервере (nginx)
HTTP_PORT=80